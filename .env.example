# Copiar a .env y calibrar por cámara. Ver services/vision_service/README.md.
# Las variables reales del entorno tienen prioridad sobre el archivo.

# --- Calzada --------------------------------------------------------------
# Polígono de la vía en coords normalizadas 0..1. Vacío = frame completo
# (funciona sin calibrar, pero cielo/árboles/andén diluyen la ocupación).
#   .venv\Scripts\python scripts\roi_picker.py
VISION_ROAD_ROI=

# Cuántas veces más grande se ve un vehículo abajo de la ROI que arriba.
# 1.0 = toma cenital, 2-3 = toma oblicua típica de cámara de tránsito.
VISION_ROAD_PERSPECTIVE=1.0

# --- Nivel de tráfico -----------------------------------------------------
# Ocupación de la calzada para medio/alto, y velocidad de flujo libre en
# anchos de frame por segundo. Medir con:
#   .venv\Scripts\python scripts\traffic_calibrate.py --frames 400
VISION_TRAFFIC_OCC_MEDIUM=0.22
VISION_TRAFFIC_OCC_HIGH=0.38
VISION_TRAFFIC_FREE_SPEED=0.08

# --- Multi-cámara ---------------------------------------------------------
# Cuántas cámaras se procesan a la vez. Cuenta cámaras, no espectadores: diez
# operarios sobre las mismas tres cámaras siguen siendo tres sesiones.
# Comparten una sola GPU, así que este número se decide midiendo: en una RTX
# 3050 una cámara va a tiempo real y dos van a 0.69x. Si las cámaras se
# quedan atrás, o se baja este número o se sube VISION_FRAME_STRIDE.
VISION_MAX_SESSIONS=3

# Volver a empezar el archivo cuando se acaba. Sirve para simular un stream
# continuo mientras no haya acceso a las cámaras reales; con una fuente RTSP
# se ignora, porque un stream no se rebobina.
VISION_LOOP_SOURCE=0

# --- Anonimización de la evidencia ----------------------------------------
# Ley 1581 de 2012 (Habeas Data). Tapa placas y rostros ANTES de escribir la
# imagen, así que el original identificable nunca llega a existir en disco.
# Apagarlo en operación real deja datos personales guardados sin base legal.
VISION_ANONYMIZE=1

# Fracción de cada caja que se tapa: abajo la placa, arriba la cabeza. Si con
# el ángulo de tu cámara ves que una placa asoma, SUBE el valor. Quedarse
# corto deja una placa legible guardada para siempre; pasarse solo cuesta un
# poco de imagen.
VISION_ANONYMIZE_PLATE_BAND=0.35
VISION_ANONYMIZE_FACE_BAND=0.30

# --- Retención de la evidencia --------------------------------------------
# Días que se conserva la IMAGEN de un incidente. El incidente en sí no se
# borra nunca: sigue en la bandeja con su veredicto. Lo que caduca es la foto,
# que es el dato personal.
#
# 0 = conservar indefinidamente. Es el valor por defecto a propósito: esta
# variable borra archivos, y un typo tiene que dejar el disco intacto en vez
# de vaciarlo. Un despliegue real TIENE que fijarla; 30 es un punto de partida
# razonable, pero el número lo decide la finalidad declarada ante la
# Secretaría, no la comodidad.
VISION_EVIDENCE_RETENTION_DAYS=0

# Registra qué borraría, sin borrar nada. Vale la pena dejarlo en 1 durante la
# primera pasada sobre evidencia ya acumulada, mirar el log, y luego apagarlo.
VISION_RETENTION_DRY_RUN=0

# --- Base de datos --------------------------------------------------------
VISION_DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/traffic_detector

# --- Resumen de incidentes con IA ----------------------------------------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
# Sin ella el servicio arranca igual y el panel de detalle funciona: lo único
# que no se ofrece es el botón "Analizar el caso".
GEMINI_API_KEY=

# Identificador del modelo. Configurable porque los nombres de Google cambian
# y quedarse fijado a uno retirado convierte un cambio de proveedor en un
# cambio de código.
#
# Va un ALIAS por defecto: el `gemini-2.5-flash` que estaba aquí antes fue
# retirado y "Analizar el caso" empezó a fallar con un 404. El alias se mueve
# solo. Si prefieres reproducibilidad, fija una versión concreta (por ejemplo
# gemini-3.6-flash) sabiendo que algún día habrá que actualizarla.
GEMINI_MODEL=gemini-flash-latest

# Segundos antes de rendirse. Una petición colgada no puede dejar esperando
# al agente que abrió el incidente. 30 se quedaban cortos: los modelos
# actuales razonan antes de responder y el SDK reintenta solo.
GEMINI_TIMEOUT=60

# --- Autenticación --------------------------------------------------------
# Secreto de firma de los tokens. Sin él el servicio arranca pero rechaza
# todo inicio de sesión — preferible a traer un valor por defecto que alguien
# olvide cambiar, que es como se filtran estos sistemas.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Duración de la sesión en minutos. Un JWT no se puede revocar antes de
# expirar, así que esto acota el daño de un token robado.
JWT_EXPIRE_MINUTES=720

# --- Turnos de trabajo ----------------------------------------------------
# Cuánto silencio se perdona antes de dejar de contar el tiempo como
# trabajado. Cubre el corte de internet y el cambio de red: a nadie se le
# descuenta tiempo por su conexión.
SHIFT_GRACE_MINUTES=10

# A partir de aquí se entiende que el turno terminó. Sin este tope, una
# pestaña olvidada abierta acumularía horas indefinidamente.
SHIFT_TIMEOUT_MINUTES=60

# Dónde corta "hoy" en el dashboard. Con UTC, en Colombia el día empezaría a
# las siete de la tarde del día anterior.
VISION_TIMEZONE=America/Bogota
