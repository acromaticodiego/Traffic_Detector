# Copiar a .env y calibrar por cámara. Ver services/vision_service/README.md.
# Las variables reales del entorno tienen prioridad sobre el archivo.

# --- Calzada --------------------------------------------------------------
# Polígono de la vía en coords normalizadas 0..1. Vacío = frame completo
# (funciona sin calibrar, pero cielo/árboles/andén diluyen la ocupación).
#   .venv\Scripts\python scripts\roi_picker.py
VISION_ROAD_ROI=

# Cuántas veces más grande se ve un vehículo abajo de la ROI que arriba.
# 1.0 = toma cenital, 2-3 = toma oblicua típica de cámara de tránsito.
VISION_ROAD_PERSPECTIVE=1.0

# --- Nivel de tráfico -----------------------------------------------------
# Ocupación de la calzada para medio/alto, y velocidad de flujo libre en
# anchos de frame por segundo. Medir con:
#   .venv\Scripts\python scripts\traffic_calibrate.py --frames 400
VISION_TRAFFIC_OCC_MEDIUM=0.22
VISION_TRAFFIC_OCC_HIGH=0.38
VISION_TRAFFIC_FREE_SPEED=0.08

# --- Base de datos --------------------------------------------------------
VISION_DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/traffic_detector
